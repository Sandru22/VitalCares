<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VitalCares.Views.Calendar"
             Title="Calendar Activități"
             BackgroundColor="#F4F6F9">
    <Grid RowDefinitions="Auto, Auto, *">

        <Border Grid.Row="0" 
                Margin="15,15,15,8" 
                Padding="15,12" 
                StrokeShape="RoundRectangle 12" 
                BackgroundColor="White" 
                StrokeThickness="0">

            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.04" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="5">
                <Label Text="Selectează Data:" FontAttributes="Bold" TextColor="#6C757D" FontSize="12" />
                <DatePicker x:Name="datePicker" 
                            Format="D" 
                            DateSelected="OnDateSelected"
                            TextColor="#10A37F"
                            FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Border>

        <Label Grid.Row="1" x:Name="lblSelectedDate" 
               Text="Activități pentru Azi" 
               FontSize="18" 
               FontAttributes="Bold" 
               TextColor="#333333"
               Margin="20,12,20,8" />

        <RefreshView Grid.Row="2" x:Name="refreshView" Refreshing="OnRefreshRequested" RefreshColor="#10A37F">
            <CollectionView x:Name="lstActivities" Margin="15,0,15,10">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,6">
                            <Border Padding="15" 
                                    StrokeShape="RoundRectangle 12" 
                                    StrokeThickness="0" 
                                    BackgroundColor="White">

                                <Border.Shadow>
                                    <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.03" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="60, *, Auto">

                                    <Label Grid.Column="0" 
                                           Text="{Binding ora_programata}" 
                                           VerticalOptions="Center" 
                                           FontAttributes="Bold" 
                                           FontSize="16"
                                           TextColor="#10A37F" />

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3" Margin="5,0,10,0">
                                        <Label Text="{Binding nume_activitate}" FontSize="16" FontAttributes="Bold" TextColor="#222222" />
                                        <Label Text="{Binding descriere}" FontSize="13" TextColor="#6C757D" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>

                                    <CheckBox Grid.Column="2" 
                                              IsChecked="{Binding este_finalizata}" 
                                              VerticalOptions="Center"
                                              Color="#10A37F"
                                              CheckedChanged="OnActivityCheckedChanged"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="40" Spacing="12">
                        <Label Text="🧘" FontSize="48" HorizontalOptions="Center"/>
                        <Label Text="Nu ai activități programate pentru această zi." 
                               HorizontalOptions="Center" 
                               TextColor="#6C757D" 
                               FontSize="14"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>