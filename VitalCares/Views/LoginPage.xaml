<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VitalCares.Views.LoginPage"
             Title="Autentificare"
             BackgroundColor="#10A37F">
    <ScrollView VerticalOptions="Center">
        <Border Margin="20" 
                Padding="25" 
                StrokeShape="RoundRectangle 12" 
                StrokeThickness="0" 
                BackgroundColor="White"
                VerticalOptions="Center">

            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.05" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="20">

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">

                        <Image Source="splash.png" Margin="10,10,10,10"/>
              

                    <Label Text="Vital Cares" 
                           FontSize="26" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           TextColor="#10A37F"/>

                    <Label Text="Sistem de monitorizare a sănătății" 
                           FontSize="14" 
                           TextColor="#6C757D" 
                           HorizontalOptions="Center" 
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <Border x:Name="borderError" 
                        BackgroundColor="#F8D7DA" 
                        Stroke="#F5C2C7"
                        StrokeShape="RoundRectangle 6" 
                        Padding="12,10" 
                        IsVisible="False">
                    <Label x:Name="lblError" 
                           Text="Email sau parolă incorectă." 
                           TextColor="#842029" 
                           FontSize="14"/>
                </Border>

                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout Spacing="5">
                        <HorizontalStackLayout Spacing="3">
                            <Label Text="Email" FontAttributes="Bold" TextColor="#333333" FontSize="14"/>
                            <Label Text="*" TextColor="Red" FontAttributes="Bold" FontSize="14"/>
                        </HorizontalStackLayout>
                        <Entry x:Name="txtEmail" 
                               Placeholder="exemplu@vitalcares.ro" 
                               Keyboard="Email" 
                               HeightRequest="48"
                               TextColor="#333333"
                               PlaceholderColor="#999999"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <HorizontalStackLayout Spacing="3">
                            <Label Text="Parolă" FontAttributes="Bold" TextColor="#333333" FontSize="14"/>
                            <Label Text="*" TextColor="Red" FontAttributes="Bold" FontSize="14"/>
                        </HorizontalStackLayout>
                        <Entry x:Name="txtPassword" 
                               Placeholder="••••••••" 
                               IsPassword="True" 
                               HeightRequest="48"
                               TextColor="#333333"
                               PlaceholderColor="#999999"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
                
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Margin="0,10">
                    <CheckBox x:Name="chkRememberMe" IsChecked="True" Color="#10A37F"/>
                    <Label Text="Rămâi conectat în aplicație" VerticalOptions="Center" TextColor="Black"/>
                </HorizontalStackLayout>
                
                <VerticalStackLayout Spacing="10" Margin="0,10,0,0">
                    <Button Text="AUTENTIFICARE" 
                            Clicked="OnLoginClicked" 
                            HeightRequest="50" 
                            BackgroundColor="#10A37F" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="8"/>
            
                    <Button Text="CREEAZĂ CONT NOU" 
                            Clicked="OnGoToRegisterClicked" 
                            HeightRequest="45" 
                            BackgroundColor="Transparent" 
                            TextColor="#10A37F" 
                            FontSize="13"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>