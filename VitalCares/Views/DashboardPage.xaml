<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:micro="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="VitalCares.Views.DashboardPage"
             Title="Istoricul măsurătorilor"
             BackgroundColor="#F4F6F9">
    <Grid RowDefinitions="Auto, *">

        <Border Grid.Row="0" 
                Margin="15,15,15,5" 
                Padding="15,12" 
                StrokeShape="RoundRectangle 12" 
                BackgroundColor="White" 
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.04" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <Label Text="Selectează Ziua pentru Analiză" FontSize="12" TextColor="#6C757D" FontAttributes="Bold"/>
                    <DatePicker x:Name="dpFiltruData" 
                                DateSelected="OnDateSelected" 
                                Format="dd MMMM yyyy" 
                                TextColor="#10A37F" FontAttributes="Bold"/>
                </VerticalStackLayout>
                <Image Grid.Column="1" Source="calendar_icon.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" Opacity="0.5"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="15,10,15,15">
            <VerticalStackLayout Spacing="16">

                <Border x:Name="lblNoDataWarning" 
                        BackgroundColor="#FFF3CD" 
                        Stroke="#FFECB5"
                        StrokeShape="RoundRectangle 8" 
                        Padding="15,12" 
                        IsVisible="False"
                        Margin="0,5">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="⚠" TextColor="#664D03" FontAttributes="Bold" FontSize="14"/>
                        <Label Text="Nu există măsurători înregistrate în această zi." 
                               TextColor="#664D03" 
                               FontAttributes="Bold" 
                               FontSize="14"/>
                    </HorizontalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 12" Padding="16,14" BackgroundColor="White" StrokeThickness="0" x:Name="panelPuls">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.03" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Evoluție Puls (BPM)" FontAttributes="Bold" FontSize="16" TextColor="#222222"/>
                            <Label Grid.Column="1" x:Name="lblPulsMediu" Text="Medie: --" FontSize="12" TextColor="#10A37F" FontAttributes="Bold" VerticalOptions="Center"/>
                        </Grid>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                            <micro:ChartView x:Name="chartPuls" HeightRequest="180" WidthRequest="1200" />
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 12" Padding="16,14" BackgroundColor="White" StrokeThickness="0" x:Name="panelTemp">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.03" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Temperatură Corporală (°C)" FontAttributes="Bold" FontSize="16" TextColor="#222222"/>
                            <Label Grid.Column="1" x:Name="lblTempMediu" Text="Medie: --" FontSize="12" TextColor="#10A37F" FontAttributes="Bold" VerticalOptions="Center"/>
                        </Grid>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                            <micro:ChartView x:Name="chartTemp" HeightRequest="180" WidthRequest="1200" />
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 12" Padding="16,14" BackgroundColor="White" StrokeThickness="0" x:Name="panelHum">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.03" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Umiditate Ambientă (%)" FontAttributes="Bold" FontSize="16" TextColor="#222222"/>
                            <Label Grid.Column="1" x:Name="lblHumMedie" Text="Medie: --" FontSize="12" TextColor="#10A37F" FontAttributes="Bold" VerticalOptions="Center"/>
                        </Grid>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                            <micro:ChartView x:Name="chartHum" HeightRequest="180" WidthRequest="1200" />
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 12" Padding="16,14" BackgroundColor="White" StrokeThickness="0" x:Name="panelEcg">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.03" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Semnal ECG Înregistrat" FontAttributes="Bold" FontSize="16" TextColor="#222222"/>
                            <Label Grid.Column="1" x:Name="lblEcgTotal" Text="Eșantioane: --" FontSize="12" TextColor="#10A37F" FontAttributes="Bold" VerticalOptions="Center"/>
                        </Grid>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                            <micro:ChartView x:Name="chartEcg" HeightRequest="180" WidthRequest="1200" />
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>